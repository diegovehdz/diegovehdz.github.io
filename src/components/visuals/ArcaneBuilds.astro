---
// Las versiones reales de Arcane Codex (carpetas de builds para WebGL), de la primera a la final.
const builds = [
	'v0.2.1a', 'v0.2.2', 'v0.2.2b', 'v0.2.2c', 'v0.2.2d', 'v0.3.1a', 'v0.3.1b', 'v0.3.2', 'v0.3.3a', 'v0.4.0', 'v0.4.0a', 'v0.5.0',
	'v0.5.0a', 'v0.5.1', 'v0.6.0', 'v0.7.0', 'v0.8.0', 'v0.9.0', 'v1.0.0', 'v2.0.0', 'v3.0.0', 'v3.1.0', 'v3.1.1',
];
---

<div class="viz-arcane" role="img" aria-label={`Línea de tiempo con las ${builds.length} versiones de Arcane Codex`}>
	<div class="a-top">
		<span class="a-cap">{builds.length} builds · unity webgl</span>
		<span class="a-cap">feb → may 2025</span>
	</div>
	<ol class="a-builds">
		{builds.map((b) => <li>{b}</li>)}
		<li class="a-final">final</li>
	</ol>
	<p class="a-word" aria-hidden="true"><span>Arcane</span><span>Codex</span></p>
</div>

<style>
	.viz-arcane {
		position: relative;
		width: 100%;
		height: 100%;
		background: var(--bg-raise);
		padding: clamp(14px, 4cqw, 28px);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		gap: 4cqw;
	}
	.a-top {
		display: flex;
		justify-content: space-between;
	}
	.a-cap {
		font: 500 clamp(10px, 2cqw, 13px) var(--font-mono);
		color: var(--ink-mute);
	}
	.a-builds {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 1.1cqw;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.a-builds li {
		font: 500 clamp(9px, 1.9cqw, 12.5px) / 1 var(--font-mono);
		color: var(--ink-soft);
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		padding: 0.45em 0.75em;
		background: var(--bg-raise);
	}
	.a-builds .a-final {
		background: var(--red);
		border-color: var(--red);
		color: var(--on-red);
		font-weight: 700;
		text-transform: uppercase;
	}
	.a-word {
		position: absolute;
		left: -0.04em;
		bottom: -0.16em;
		margin: 0;
		display: flex;
		flex-direction: column;
		font-family: var(--font-display);
		font-weight: 900;
		font-stretch: 125%;
		letter-spacing: -0.075em;
		line-height: 0.8;
		text-transform: uppercase;
		font-size: 20cqw;
		color: var(--red);
		opacity: 0.9;
	}
</style>
