---
// Regresión logística entrenada con descenso por gradiente sobre dos nubes de puntos (en el build, con semilla).
import { gaussian, mulberry32 } from '../../lib/rng';

const rand = mulberry32(42);
const data: { x: number; y: number; c: 0 | 1 }[] = [];
for (let i = 0; i < 70; i++) data.push({ x: -0.9 + gaussian(rand) * 0.62, y: -0.35 + gaussian(rand) * 0.55, c: 0 });
for (let i = 0; i < 70; i++) data.push({ x: 0.85 + gaussian(rand) * 0.6, y: 0.4 + gaussian(rand) * 0.58, c: 1 });

let w0 = 0;
let w1 = 0;
let w2 = 0;
const lr = 0.4;
for (let epoch = 0; epoch < 600; epoch++) {
	let g0 = 0;
	let g1 = 0;
	let g2 = 0;
	for (const p of data) {
		const z = w0 + w1 * p.x + w2 * p.y;
		const err = 1 / (1 + Math.exp(-z)) - p.c;
		g0 += err;
		g1 += err * p.x;
		g2 += err * p.y;
	}
	w0 -= (lr * g0) / data.length;
	w1 -= (lr * g1) / data.length;
	w2 -= (lr * g2) / data.length;
}
const acc = data.filter((p) => (w0 + w1 * p.x + w2 * p.y > 0 ? 1 : 0) === p.c).length / data.length;

const W = 640;
const H = 480;
const sx = (x: number) => W / 2 + x * 130;
const sy = (y: number) => H / 2 + 30 - y * 130;
// frontera: w0 + w1 x + w2 y = 0  ->  y = -(w0 + w1 x) / w2
const xa = -2.6;
const xb = 2.6;
const ya = -(w0 + w1 * xa) / w2;
const yb = -(w0 + w1 * xb) / w2;
// semiplano de la clase 1 (z > 0): del lado superior de la frontera cuando w2 > 0
const edgeY = w2 > 0 ? -10 : H + 10;
const shade = `M${sx(xa)},${sy(ya)} L${sx(xb)},${sy(yb)} L${sx(xb)},${edgeY} L${sx(xa)},${edgeY} Z`;
---

<svg class="viz-ml" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Frontera de decisión de una regresión logística; exactitud ${Math.round(acc * 100)} %`}>
	<defs>
		<clipPath id="ml-clip"><rect x="0" y="80" width={W} height={H - 80}></rect></clipPath>
	</defs>
	<g clip-path="url(#ml-clip)">
		<path d={shade} class="ml-half" />
		<line x1={sx(xa)} y1={sy(ya)} x2={sx(xb)} y2={sy(yb)} class="ml-line" />
		{data.map((p) => <circle cx={sx(p.x)} cy={sy(p.y)} r="5.5" class={p.c ? 'ml-a' : 'ml-b'} />)}
	</g>
	<text x="28" y="40" class="ml-cap">regresión logística · descenso por gradiente</text>
	<text x="28" y="60" class="ml-cap ml-cap--soft">600 épocas · exactitud {Math.round(acc * 100)} %</text>
</svg>

<style>
	.viz-ml {
		width: 100%;
		height: 100%;
		background: var(--bg-raise);
	}
	.ml-cap {
		font: 500 13px var(--font-mono);
		fill: var(--ink-mute);
	}
	.ml-cap--soft {
		opacity: 0.7;
	}
	.ml-half {
		fill: var(--red);
		opacity: 0.08;
	}
	.ml-line {
		stroke: var(--red);
		stroke-width: 3;
	}
	.ml-a {
		fill: var(--red);
	}
	.ml-b {
		fill: none;
		stroke: var(--ink-soft);
		stroke-width: 2;
	}
</style>
