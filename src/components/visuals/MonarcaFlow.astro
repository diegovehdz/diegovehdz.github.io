---
// Flujo de una solicitud de viaje en Monarca: cada paso del flujo deja un registro en request-logs
// (el módulo de bitácora que implementé). Los registros se "escriben" al ritmo del recorrido.
const steps = [
	{ role: 'Solicitante', mod: 'requests', log: 'solicitud creada' },
	{ role: 'Aprobador', mod: 'revisions', log: 'aprobada' },
	{ role: 'Control de costos', mod: 'cost-centers', log: 'presupuesto validado' },
	{ role: 'Agente de viajes', mod: 'reservations', log: 'vuelo y hotel reservados' },
	{ role: 'Comprobación', mod: 'vouchers · cfdi', log: 'comprobantes XML validados' },
];
const x = 70;
const y0 = 120;
const gap = 76;
const ys = steps.map((_, i) => y0 + i * gap);
const DUR = '10s';
const t = (i: number) => i / steps.length;
// apagado antes de su paso, encendido desde su paso hasta el final del ciclo
const rowTimes = (i: number) => `0;${t(i).toFixed(3)};${Math.min(t(i) + 0.02, 0.96).toFixed(3)};0.97;1`;
// el conector brilla solo mientras el recorrido está en ese paso
const linkTimes = (i: number) => `0;${t(i).toFixed(3)};${(t(i) + 0.01).toFixed(3)};${(t(i) + 0.19).toFixed(3)};${(t(i) + 0.2).toFixed(3)};1`;
---

<svg class="viz-monarca" viewBox="0 0 640 480" role="img" aria-label="Flujo de aprobación de una solicitud de viaje en Monarca y su bitácora request-logs">
	<text x="28" y="44" class="v-cap">solicitud de viaje · flujo de aprobación</text>
	<text x="28" y="64" class="v-cap v-cap--soft">cada paso queda en request-logs</text>

	<line x1={x} y1={ys[0]} x2={x} y2={ys[ys.length - 1]} class="v-rail" />
	<line x1={x} y1={ys[0]} x2={x} y2={ys[ys.length - 1]} class="v-rail v-rail--flow" />

	<rect x="360" y="92" width="252" height="356" rx="14" class="v-panel" />
	<text x="378" y="118" class="v-cap">request_logs</text>

	{
		steps.map((s, i) => (
			<g>
				<circle cx={x} cy={ys[i]} r="15" class="v-node" />
				<text x={x} y={ys[i] + 4.5} class="v-num" text-anchor="middle">
					{i + 1}
				</text>
				<text x={x + 30} y={ys[i] - 3} class="v-role">
					{s.role}
				</text>
				<text x={x + 30} y={ys[i] + 15} class="v-mod">
					{s.mod}
				</text>
				<line x1="268" y1={ys[i]} x2="368" y2={ys[i]} class="v-link" opacity="0.25">
					<animate attributeName="opacity" dur={DUR} repeatCount="indefinite" keyTimes={linkTimes(i)} values="0.25;0.25;1;1;0.25;0.25" />
				</line>
				<g opacity="0.2">
					<animate attributeName="opacity" dur={DUR} repeatCount="indefinite" keyTimes={rowTimes(i)} values="0.2;0.2;1;1;0.2" />
					<rect x="374" y={ys[i] - 14} width="224" height="30" rx="8" class="v-row-bg" />
					<text x="386" y={ys[i] + 5} class="v-row-id">
						#{i + 1}
					</text>
					<text x="414" y={ys[i] + 5} class="v-row-text">
						{s.log}
					</text>
				</g>
			</g>
		))
	}

	<circle r="6" cx={x} cy={ys[0]} class="v-token">
		<animate attributeName="cy" values={ys.join(';')} dur={DUR} repeatCount="indefinite" calcMode="discrete" />
	</circle>
</svg>

<style>
	.viz-monarca {
		width: 100%;
		height: 100%;
		background: var(--bg-raise);
	}
	.v-cap {
		font: 500 13px var(--font-mono);
		fill: var(--ink-mute);
	}
	.v-cap--soft {
		opacity: 0.7;
	}
	.v-rail {
		stroke: var(--line-strong);
		stroke-width: 2;
	}
	.v-rail--flow {
		stroke: var(--red);
		stroke-width: 3;
		stroke-dasharray: 8 10;
		animation: monarca-dash 1.8s linear infinite;
	}
	.v-node {
		fill: var(--bg);
		stroke: var(--red);
		stroke-width: 3;
	}
	.v-num {
		font: 700 13px var(--font-body);
		fill: var(--ink);
	}
	.v-role {
		font: 800 17px var(--font-body);
		letter-spacing: -0.03em;
		fill: var(--ink);
	}
	.v-mod {
		font: 400 11.5px var(--font-mono);
		fill: var(--ink-mute);
	}
	.v-link {
		stroke: var(--red);
		stroke-width: 1.5;
		stroke-dasharray: 3 5;
	}
	.v-panel {
		fill: var(--bg);
		stroke: var(--line-strong);
		stroke-width: 1.5;
	}
	.v-row-bg {
		fill: var(--bg-raise);
	}
	.v-row-id {
		font: 700 11px var(--font-mono);
		fill: var(--red-ink);
	}
	.v-row-text {
		font: 500 11.5px var(--font-mono);
		fill: var(--ink-soft);
	}
	.v-token {
		fill: var(--red-ink);
	}
	@keyframes monarca-dash {
		to {
			stroke-dashoffset: -36;
		}
	}
</style>
