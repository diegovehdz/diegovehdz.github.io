---
// Pieza interactiva del texto "La ruta del café": agrega puntos y compara heurísticas del TSP.
---

<figure class="tspp wide" data-tsp>
	<div class="tspp__stage">
		<canvas aria-label="Lienzo para agregar cafeterías y calcular rutas" role="img"></canvas>
		<p class="tspp__hint" data-hint>Toca el lienzo para agregar cafeterías</p>
		<span class="tspp__scale mono">el lienzo mide 3 km de ancho</span>
	</div>
	<figcaption class="tspp__bar">
		<div class="tspp__btns">
			<button class="pill pill--sm" type="button" data-act="random">8 al azar</button>
			<button class="pill pill--sm" type="button" data-act="nn">1 · Vecino más cercano</button>
			<button class="pill pill--sm" type="button" data-act="opt">2 · Mejorar con 2-opt</button>
			<button class="pill pill--sm" type="button" data-act="brute">Fuerza bruta (≤ 9)</button>
			<button class="pill pill--sm pill--ghost" type="button" data-act="clear">Borrar</button>
		</div>
		<dl class="tspp__read" aria-live="polite">
			<div><dt>cafeterías</dt><dd data-r="n">0</dd></div>
			<div><dt>rutas posibles</dt><dd data-r="routes">—</dd></div>
			<div><dt>vecino más cercano</dt><dd data-r="nn">—</dd></div>
			<div><dt>2-opt</dt><dd data-r="opt">—</dd></div>
			<div><dt>óptimo</dt><dd data-r="brute">—</dd></div>
		</dl>
	</figcaption>
</figure>

<style>
	.tspp {
		margin: 2.4em 0;
		border: 1.5px solid var(--line-strong);
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--bg-raise);
	}

	.tspp__stage {
		position: relative;
		aspect-ratio: 16 / 9;
		cursor: crosshair;
		touch-action: manipulation;
	}

	canvas {
		width: 100%;
		height: 100%;
	}

	.tspp__hint {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		margin: 0;
		color: var(--ink-mute);
		font: 500 var(--step--1) var(--font-mono);
		pointer-events: none;
	}

	.tspp__hint[hidden] {
		display: none;
	}

	.tspp__scale {
		position: absolute;
		right: 12px;
		bottom: 10px;
		font-size: var(--step--2);
		color: var(--ink-mute);
		pointer-events: none;
	}

	.tspp__bar {
		display: grid;
		gap: 14px;
		padding: 14px 16px 16px;
		border-top: 1px solid var(--line);
		margin: 0 !important;
		color: var(--ink);
	}

	.tspp__btns {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.tspp__read {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 8px 12px;
		margin: 0;
		font-family: var(--font-mono);
	}

	.tspp__read dt {
		font-size: var(--step--2);
		color: var(--ink-mute);
	}

	.tspp__read dd {
		margin: 2px 0 0;
		font-size: var(--step--1);
		font-weight: 600;
	}

	@media (max-width: 700px) {
		.tspp__read {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>

<script>
	import { bruteForce, nearestNeighbor, pathLength, tourCount, twoOpt } from '../lib/tsp';

	const KM_WIDE = 3;

	document.querySelectorAll<HTMLElement>('[data-tsp]').forEach((root) => {
		const canvas = root.querySelector('canvas')!;
		const ctx = canvas.getContext('2d')!;
		const hint = root.querySelector<HTMLElement>('[data-hint]')!;
		const r = (k: string) => root.querySelector<HTMLElement>(`[data-r="${k}"]`)!;
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// puntos en coordenadas normalizadas (0–1 a lo ancho, 0–9/16 a lo alto)
		let pts: { x: number; y: number }[] = [];
		let tour: number[] = [];
		let partial = 0; // aristas visibles mientras se anima
		let busy = false;
		let W = 0;
		let H = 0;
		const results: Record<string, number | null> = { nn: null, opt: null, brute: null };

		const dist = (i: number, j: number) => Math.hypot(pts[i].x - pts[j].x, pts[i].y - pts[j].y) * KM_WIDE;
		const fmtKm = (v: number | null) => (v === null ? '—' : `${v.toFixed(2)} km`);

		function resize() {
			const rect = canvas.getBoundingClientRect();
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			W = rect.width;
			H = rect.height;
			canvas.width = Math.round(W * dpr);
			canvas.height = Math.round(H * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			draw();
		}

		function draw() {
			const css = getComputedStyle(root);
			const red = css.getPropertyValue('--red').trim();
			const ink = css.getPropertyValue('--ink').trim();
			const bg = css.getPropertyValue('--bg').trim();
			ctx.clearRect(0, 0, W, H);
			const P = (i: number) => [pts[i].x * W, (pts[i].y * W)] as const;
			if (tour.length > 1) {
				ctx.strokeStyle = red;
				ctx.lineWidth = 3;
				ctx.lineJoin = 'round';
				ctx.beginPath();
				const edges = Math.min(partial, tour.length);
				for (let k = 0; k <= edges && k < tour.length + 1; k++) {
					const idx = tour[k % tour.length];
					const [x, y] = P(idx);
					if (k === 0) ctx.moveTo(x, y);
					else ctx.lineTo(x, y);
				}
				ctx.stroke();
			}
			pts.forEach((_, i) => {
				const [x, y] = P(i);
				ctx.fillStyle = bg;
				ctx.strokeStyle = i === 0 ? red : ink;
				ctx.lineWidth = 2.5;
				ctx.beginPath();
				ctx.arc(x, y, i === 0 ? 8 : 6.5, 0, Math.PI * 2);
				ctx.fill();
				ctx.stroke();
			});
		}

		function readout() {
			r('n').textContent = String(pts.length);
			r('routes').textContent = pts.length >= 3 ? tourCount(pts.length).toLocaleString('es-MX') : '—';
			r('nn').textContent = fmtKm(results.nn);
			r('opt').textContent = fmtKm(results.opt);
			r('brute').textContent = fmtKm(results.brute);
			hint.hidden = pts.length > 0;
			const brute = root.querySelector<HTMLButtonElement>('[data-act="brute"]')!;
			brute.disabled = pts.length > 9 || pts.length < 3;
			brute.title = pts.length > 9 ? 'Con más de 9 puntos tardaría demasiado' : '';
		}

		function reset(keepPoints = true) {
			if (!keepPoints) pts = [];
			tour = [];
			partial = 0;
			results.nn = results.opt = results.brute = null;
			readout();
			draw();
		}

		const sleep = (ms: number) => new Promise((res) => setTimeout(res, reduce ? 0 : ms));

		async function animateEdges(order: number[]) {
			tour = order;
			if (reduce) {
				partial = order.length;
				draw();
				return;
			}
			for (partial = 1; partial <= order.length; partial++) {
				draw();
				await sleep(Math.max(30, 500 / order.length));
			}
		}

		async function run(act: string) {
			if (busy) return;
			if (act === 'clear') return reset(false);
			if (act === 'random') {
				pts = Array.from({ length: 8 }, () => ({ x: 0.06 + Math.random() * 0.88, y: (0.06 + Math.random() * 0.88) * (9 / 16) }));
				return reset();
			}
			if (pts.length < 3) {
				hint.hidden = false;
				hint.textContent = 'Agrega al menos 3 cafeterías';
				return;
			}
			busy = true;
			const n = pts.length;
			if (act === 'nn') {
				const order = nearestNeighbor(n, dist, 0);
				results.nn = pathLength(order, dist, true);
				await animateEdges(order);
			}
			if (act === 'opt') {
				let order = tour.length === n ? tour.slice() : nearestNeighbor(n, dist, 0);
				if (tour.length !== n) await animateEdges(order);
				const steps: number[][] = [];
				order = twoOpt(order, dist, true, (o) => steps.push(o));
				for (const s of steps) {
					tour = s;
					partial = n;
					draw();
					await sleep(140);
				}
				tour = order;
				partial = n;
				results.opt = pathLength(order, dist, true);
				draw();
			}
			if (act === 'brute') {
				const { order } = bruteForce(n, dist);
				results.brute = pathLength(order, dist, true);
				tour = order;
				partial = n;
				draw();
			}
			readout();
			busy = false;
		}

		canvas.addEventListener('click', (e) => {
			if (busy || pts.length >= 40) return;
			const rect = canvas.getBoundingClientRect();
			pts.push({ x: (e.clientX - rect.left) / rect.width, y: (e.clientY - rect.top) / rect.width });
			hint.textContent = 'Toca el lienzo para agregar cafeterías';
			reset();
		});
		root.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((b) => b.addEventListener('click', () => run(b.dataset.act!)));
		window.addEventListener('themechange', draw);
		new ResizeObserver(resize).observe(canvas);
		readout();
	});
</script>
