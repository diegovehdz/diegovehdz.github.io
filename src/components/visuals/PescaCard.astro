---
// Tarjeta de Pesca en Xochimilco: el riel de la pelea con un ajolote dentro de la barra, en pixel art.
import { PECES } from '../../data/peces';

const ajolote = PECES.find((p) => p.id === 'ajolote')!.sprite;
const px: { x: number; y: number }[] = [];
ajolote.forEach((row, j) => [...row].forEach((c, i) => c === '#' && px.push({ x: 33 + i, y: 30 + j })));
// trama de agua del riel (Bayer 4 × 4 a densidad baja)
const B4 = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5];
const agua: { x: number; y: number }[] = [];
for (let y = 6; y < 58; y++) for (let x = 31; x < 51; x++) if (B4[(y & 3) * 4 + (x & 3)] < 2) agua.push({ x, y });
---

<div class="viz-pesca" role="img" aria-label="Un ajolote dentro de la barra del minijuego de pesca">
	<svg viewBox="0 0 80 64" shape-rendering="crispEdges" aria-hidden="true">
		<rect x="0" y="40" width="26" height="1" class="ink"></rect>
		<rect x="10" y="20" width="1" height="20" class="ink"></rect>
		<rect x="18" y="38" width="3" height="2" class="red"></rect>
		{agua.map((p) => <rect x={p.x} y={p.y} width="1" height="1" class="mute" />)}
		<rect x="30" y="5" width="22" height="54" class="frame"></rect>
		<rect x="31" y="24" width="20" height="18" class="bar"></rect>
		<rect x="31" y="24" width="20" height="1" class="red"></rect>
		<rect x="31" y="41" width="20" height="1" class="red"></rect>
		{px.map((p) => <rect x={p.x} y={p.y} width="1" height="1" class="ink" />)}
		<rect x="55" y="5" width="5" height="54" class="frame"></rect>
		<rect x="56" y="22" width="3" height="36" class="ink"></rect>
	</svg>
	<span class="p-cap mono">mantén presionado · suelta</span>
</div>

<style>
	.viz-pesca {
		position: relative;
		width: 100%;
		height: 100%;
		display: grid;
		place-items: center;
		background: var(--bg-raise);
	}

	svg {
		width: 72%;
		height: 86%;
	}

	.ink {
		fill: var(--ink);
	}

	.mute {
		fill: var(--ink-mute);
	}

	.red {
		fill: var(--red);
	}

	.bar {
		fill: var(--red);
		opacity: 0.45;
	}

	.frame {
		fill: none;
		stroke: var(--ink);
		stroke-width: 1;
	}

	.p-cap {
		position: absolute;
		left: 12px;
		bottom: 10px;
		font-size: clamp(9px, 1.8cqw, 12px);
		color: var(--ink-mute);
	}
</style>
